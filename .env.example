# ActuFoot RDC — variables d'environnement (front-end Vite)
# Copier vers .env pour le développement local. NE JAMAIS COMMITER LE .env.
# Sur Vercel : Project Settings > Environment Variables.

# URL du projet Supabase (le MÊME que l'ancien site, pour conserver les données)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique (anon) Supabase — destinée au client, pas un secret serveur
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# --- Fonctions serverless /rss.xml et /sitemap.xml (api/) ---
# Mêmes valeurs, mais SANS préfixe VITE_ (non exposées au navigateur) :
# SUPABASE_URL=https://votre-projet.supabase.co
# SUPABASE_ANON_KEY=votre-cle-anon-publique
